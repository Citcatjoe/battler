{
  "name": "battler",
  "private": true,
  "version": "0.121.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -p . && vitest run",
    "balance": "vitest run --config vitest.balance.config.ts scripts/balance.report.ts --silent=false",
    "logs": "vitest run --config vitest.balance.config.ts scripts/logs.report.ts --silent=false",
    "relics": "vitest run --config vitest.balance.config.ts scripts/relics.report.ts --silent=false",
    "campaign": "vitest run --config vitest.balance.config.ts scripts/campaign.report.ts --silent=false",
    "synergy": "vitest run --config vitest.balance.config.ts scripts/synergy.report.ts --silent=false",
    "season": "vitest run --config vitest.balance.config.ts scripts/season.report.ts --silent=false",
    "ramp": "vitest run --config vitest.balance.config.ts scripts/ramp.report.ts --silent=false",
    "sfx": "node --env-file=.env.local scripts/gen-sfx.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@elevenlabs/elevenlabs-js": "^2.74.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.3"
  }
}
