{
  "name": "battler",
  "private": true,
  "version": "0.38.12",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -p . && vitest run",
    "balance": "vitest run --config vitest.balance.config.ts scripts/balance.report.ts --silent=false",
    "logs": "vitest run --config vitest.balance.config.ts scripts/logs.report.ts --silent=false"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.3"
  }
}
